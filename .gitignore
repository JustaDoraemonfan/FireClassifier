# ============================================================
# FireDistinguish — Git Ignore
# ============================================================


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python cache / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/


# ============================================================
# VIRTUAL ENVIRONMENTS
# ============================================================

.venv/
venv/
env/
ENV/


# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

.env
.env.*
!.env.example


# ============================================================
# JUPYTER
# ============================================================

.ipynb_checkpoints/


# ============================================================
# IDE / EDITOR
# ============================================================

.vscode/
.idea/

*.swp
*.swo


# ============================================================
# OPERATING SYSTEM
# ============================================================

.DS_Store
Thumbs.db
desktop.ini


# ============================================================
# RAW DATA
# ============================================================

# FIRMS raw downloads
data/raw/

# Any large raw datasets
*.zip
*.gz
*.tar
*.tar.gz


# ============================================================
# PROCESSED DATA
# ============================================================

# Generated event datasets
data/processed/
data/processed-backup/


# ============================================================
# VERIFICATION DATA
# ============================================================

# Satellite imagery / TIFF files
data/verification/**/*.tif
data/verification/**/*.tiff
data/verification/**/*.TIF
data/verification/**/*.TIFF

# Satellite images / rendered chips
data/verification/**/*.png
data/verification/**/*.jpg
data/verification/**/*.jpeg
data/verification/**/*.webp

# Satellite evidence directories
data/verification/satellite/

# Generated verification outputs
data/verification/verification_candidates_v*.csv

# OSM enrichment outputs
data/verification/*osm*.csv

data/verification/



data/verification-backup/**/*.tif
data/verification-backup/**/*.tiff
data/verification-backup/**/*.TIF
data/verification-backup/**/*.TIFF

# Satellite images / rendered chips
data/verification-backup/**/*.png
data/verification-backup/**/*.jpg
data/verification-backup/**/*.jpeg
data/verification-backup/**/*.webp

# Satellite evidence directories
data/verification-backup/satellite/

# Generated verification outputs
data/verification-backup/verification_candidates_v*.csv
data/verification-backup/verification_review_v*.csv

# OSM enrichment outputs
data/verification-backup/*osm*.csv

data/verification-backup/

