*.local
config.local.*


# ============================================================
# SHARE WITH COLLABORATORS — exceptions to rules above
# (order matters: these must stay at the bottom of the file)
# ============================================================

# Original candidate dataset needed to run manual_verify_events.py.
# NOTE: verification_review_v2*.csv (the generated review output)
# stays ignored on purpose — each reviewer keeps their own local copy.
!data/verification/verification_review_v1.csv

# Satellite evidence chips needed by the review app.
# Directory itself must be un-ignored first, then the file types.
!data/verification/satellite/
!data/verification/satellite/**/
!data/verification/satellite/chips/**/*.png
!data/verification/satellite/chips/**/*.jpg
!data/verification/satellite/chips/**/*.jpeg
!data/verification/satellite/chips/**/*.webp